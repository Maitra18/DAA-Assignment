class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        unordered_map<int,int> m;
        for(int i=0;i<nums2.size();i++){
            nums1.push_back(nums2[i]);
        }
        sort(nums1.begin(),nums1.end());
        double ans=0;
        int n=nums1.size();
        if(n%2!=0){
            ans=nums1[n/2];
        }
        else{
            double c1=nums1[n/2];
            double c2=nums1[(n/2)-1];
            ans=(c1+c2)/2;
        }
        return ans;
    }
};
