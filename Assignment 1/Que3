class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int m = matrix.size();
        int n = matrix[0].size();
        int i = 0, j = n-1;
        while (i < m && j >-1) {
            int curr=matrix[i][j];
            if(curr==target) return true;
            if(curr<target){
                i++;
            }
            else{j--;}
        }
        return false;
    }
};
