class Solution {
public:
    int search(vector<int>& nums, int target) {
        int n=nums.size();
        int left=n/2,right=n/2;
        
        for(int i=0;i<=n/2;i++){
            if (left >= 0 && nums[left] == target){ return left;}
            if (right < n && nums[right] == target) { return right;}
            
            left--;
            right++;
        }
        return -1;
    }
};
